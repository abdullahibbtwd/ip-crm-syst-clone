  invoice             Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([matterId])
  @@index([date])
  @@index([invoiceId])
  @@index([sourceRenewalWindowId])
  @@map("fixed_fees")
}

enum InvoiceStatus {
  draft
  issued
  void

  @@map("invoice_status")
}

enum PaymentStatus {
  unpaid
  partial
  paid

  @@map("payment_status")
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  matterId      String        @map("matter_id") @db.Uuid
  invoiceNumber String?       @unique @map("invoice_number")
  status        InvoiceStatus @default(draft)
  issueDate     DateTime?     @map("issue_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  currency      String        @default("EUR")
  subtotal      Decimal       @db.Decimal(12, 2)
  taxRate       Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  pdfStorageKey String?       @map("pdf_storage_key")
  notes         String?
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  matter    Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  createdBy User             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments  InvoicePayment[]
  timeEntries TimeEntry[]
  fixedFees   FixedFee[]

  @@index([clientId])
  @@index([matterId])
  @@index([status])
  @@index([paymentStatus])
  @@map("invoices")
}

model InvoicePayment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  paidAt       DateTime @map("paid_at") @db.Timestamptz(6)
  method       String?
  reference    String?
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("InvoicePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_payments")
}

model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_sequences")
}

enum NotificationType {
  deadline_reminder
  deadline_escalation
  task_assigned
  renewal_instruction_received
  partner_instruction_update
  client_approval_update
  watch_alert_created
  watch_alert_triaged
  general

  @@map("notification_type")
}

enum ClientApprovalStatus {
  draft
  pending
  approved
  rejected

  @@map("client_approval_status")
}

model ClientApprovalRequest {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matterId          String               @map("matter_id") @db.Uuid
  clientId          String               @map("client_id") @db.Uuid
  title             String
  description       String?              @db.Text
  status            ClientApprovalStatus @default(draft)
  documentVersionId String?              @map("document_version_id") @db.Uuid
  dueDate           DateTime?            @map("due_date") @db.Date
  decisionNote      String?              @map("decision_note") @db.Text
  requestedById     String               @map("requested_by_id") @db.Uuid
  decidedById       String?              @map("decided_by_id") @db.Uuid
  requestedAt       DateTime?            @map("requested_at") @db.Timestamptz(6)
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  matter          Matter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentVersion MatterDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  requestedBy     User                   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy       User?                  @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([matterId])
  @@index([clientId])
  @@index([status])
  @@map("client_approval_requests")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  title       String
  body        String?
  resource    String?
  resourceId  String?          @map("resource_id") @db.Uuid
  linkUrl     String?          @map("link_url")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  emailSentAt DateTime?        @map("email_sent_at") @db.Timestamptz(6)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum WatchProfileStatus {
  active
  paused
  archived

  @@map("watch_profile_status")
}

enum WatchFrequency {
  daily
  weekly

  @@map("watch_frequency")
}

enum WatchAlertStatus {
  new
  rejected
  accepted

  @@map("watch_alert_status")
}

enum WatchRegistrySource {
  BPO
  EUIPO
  WIPO
  EPO

  @@map("watch_registry_source")
}

model WatchProfile {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String             @map("client_id") @db.Uuid
  markText      String             @map("mark_text")
  jurisdictions String[]           @default([])
  niceClasses   Int[]              @default([]) @map("nice_classes")
  frequency     WatchFrequency     @default(weekly)
  status        WatchProfileStatus @default(active)
  createdById   String             @map("created_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User         @relation("WatchProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  alerts    WatchAlert[]

  @@index([clientId])
  @@index([status])
  @@map("watch_profiles")
}

model WatchAlert {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchProfileId    String              @map("watch_profile_id") @db.Uuid
  clientId          String              @map("client_id") @db.Uuid
  conflictingMark   String              @map("conflicting_mark")
  source            WatchRegistrySource
  jurisdiction      String?
  applicationNumber String?             @map("application_number")
  /// 0–1 similarity vs watched mark (pg_trgm conflict_trgm_score).
  similarityScore   Float?              @map("similarity_score")
  matchMethod       String?             @map("match_method")
  status            WatchAlertStatus    @default(new)
  matterId          String?             @map("matter_id") @db.Uuid
  detectedAt        DateTime            @default(now()) @map("detected_at") @db.Timestamptz(6)
  triagedAt         DateTime?           @map("triaged_at") @db.Timestamptz(6)
  triagedById       String?             @map("triaged_by_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  watchProfile WatchProfile @relation(fields: [watchProfileId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  matter       Matter?      @relation(fields: [matterId], references: [id], onDelete: SetNull)
  triagedBy    User?        @relation("WatchAlertTriagedBy", fields: [triagedById], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status, detectedAt])
  @@index([watchProfileId])
  @@index([similarityScore])
  @@map("watch_alerts")
}

enum RetentionAction {
  anonymize
  delete

  @@map("retention_action")
}

model RetentionRule {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    String          @map("entity_type")
  conditionJson Json            @default("{}") @map("condition_json")
  retentionDays Int             @map("retention_days")
  action        RetentionAction
  isActive      Boolean         @default(true) @map("is_active")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entityType])
  @@map("retention_rules")
}

enum BroadcastAudience {
  active_clients
  pending_eu_renewals
  trademark_matters
  manual

  @@map("broadcast_audience")
}

enum BroadcastStatus {
  queued
  sending
  completed
  failed

  @@map("broadcast_status")
}

enum BroadcastRecipientStatus {
  pending
  sent
  failed
  skipped

  @@map("broadcast_recipient_status")
}

model Broadcast {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject         String
  bodyText        String           @map("body_text") @db.Text
  bodyHtml        String?          @map("body_html") @db.Text
  audience        BroadcastAudience
  audienceFilter  Json?            @map("audience_filter")
  status          BroadcastStatus  @default(queued)
  totalRecipients Int              @default(0) @map("total_recipients")
  sentCount       Int              @default(0) @map("sent_count")
  failedCount     Int              @default(0) @map("failed_count")
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)

  createdBy  User                 @relation("BroadcastCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recipients BroadcastRecipient[]
  portalCopies PortalBroadcastCopy[]

  @@index([createdAt])
  @@index([status])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  broadcastId String                   @map("broadcast_id") @db.Uuid
  clientId    String?                  @map("client_id") @db.Uuid
  email       String
  displayName String?                  @map("display_name")
  status      BroadcastRecipientStatus @default(pending)
  error       String?
  sentAt      DateTime?                @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  broadcast   Broadcast             @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  client      Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  portalCopy  PortalBroadcastCopy?

  @@index([broadcastId, status])
  @@index([email])
  @@map("broadcast_recipients")
}

/// Per-client snapshot of a sent firm broadcast for the portal Messages inbox.
model PortalBroadcastCopy {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  broadcastId          String    @map("broadcast_id") @db.Uuid
  broadcastRecipientId String    @unique @map("broadcast_recipient_id") @db.Uuid
  subject              String
  bodyText             String    @map("body_text") @db.Text
  bodyHtml             String?   @map("body_html") @db.Text
  sentAt               DateTime  @map("sent_at") @db.Timestamptz(6)
  readAt               DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  broadcast          Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastRecipient BroadcastRecipient @relation(fields: [broadcastRecipientId], references: [id], onDelete: Cascade)

  @@index([clientId, sentAt])
  @@index([broadcastId])
  @@map("portal_broadcast_copies")
}

/// Encrypted system credentials (SSO, integrations). Plaintext never stored for secret keys.
model SystemSecret {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category       String
  key            String
  encryptedValue String?  @map("encrypted_value")
  nonSecretValue String?  @map("non_secret_value")
  lastFour       String?  @map("last_four") @db.VarChar(8)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("SystemSecretUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([category, key])
  @@index([category])
  @@map("system_secrets")
}
