# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# Used by docker-compose.dev.yml (Postgres, Redis, MinIO) and the NestJS backend.
# Prisma loads DATABASE_URL from here via backend/prisma.config.ts.

# -----------------------------------------------------------------------------
# PostgreSQL (Docker)
# -----------------------------------------------------------------------------
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ip_consulting_crm
# Host port mapped to container 5432 - use 5433 if local Postgres already uses 5432
POSTGRES_PORT=5433

# Backend / Prisma connection (host dev: backend on host → Postgres in Docker)
DATABASE_URL=postgresql://crm_admin:change-me@localhost:5433/ip_consulting_crm?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ: notifications, deadline scan)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# App ports
# -----------------------------------------------------------------------------
# Host → container. Backend listens on 3002 inside the image.
# Frontend Docker image serves nginx on port 80 (map FRONTEND_PORT:80).
BACKEND_PORT=3002
FRONTEND_PORT=5173
# NestJS listen port (defaults to 3002 if unset)
PORT=3002

# -----------------------------------------------------------------------------
# JWT - use long random strings in production (min 32 characters)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# App URLs (CORS, SSO redirects, password-reset links)
# -----------------------------------------------------------------------------
API_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173
# Auth cookies: Secure is derived from FRONTEND_URL (https → Secure). For HTTP deploys
# (e.g. http://your-server:5173 on Coolify), keep FRONTEND_URL as http://… or set COOKIE_SECURE=false.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# SSO - leave client ID/secret blank until IdP apps are registered
# Redirect URIs must use the frontend origin, e.g. http://localhost:5173/api/auth/sso/google/callback
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# MinIO (matter document storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=crm_minio
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ip-crm-documents
MINIO_ACCESS_KEY=crm_minio
MINIO_SECRET_KEY=change-me
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# Invoice PDF (Puppeteer)
# -----------------------------------------------------------------------------
# Firm name shown on issued invoice PDFs (fallback when logo file is missing)
INVOICE_FIRM_NAME=IP Consulting
# Optional custom logo path (default: backend/src/assets/logo.png, copied to dist/assets on build)
# INVOICE_LOGO_PATH=/path/to/logo.png
# Letterhead / merge-field defaults (document generation)
# FIRM_WEBSITE=www.ipconsulting.eu
# FIRM_PHONE=+359 2 123 4567
# FIRM_EMAIL=office@ipconsulting.eu
# FIRM_ADDRESS_LINE1=76A James Bourchier Blvd.
# FIRM_ADDRESS_LINE2=1407 Sofia, Bulgaria
# Docker/production: path to system Chromium (set automatically in backend Dockerfile)
# PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/puppeteer-chromium
# Optional: pre-launch browser on API startup (faster first invoice issue)
# PUPPETEER_WARMUP=true

# -----------------------------------------------------------------------------
# Email (optional — if SMTP_HOST is unset, notification / broadcast / password-reset
# emails are logged to the backend console instead of being sent)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IP Consulting CRM <noreply@example.com>

# -----------------------------------------------------------------------------
# Deadline reminder scan (BullMQ cron)
# -----------------------------------------------------------------------------
# Nightly cron (default 02:00). Set DEADLINE_SCAN_ON_STARTUP=true to run once on backend boot.
DEADLINE_SCAN_CRON=0 2 * * *
DEADLINE_SCAN_ON_STARTUP=false

# GDPR retention scan (default 03:00). Set RETENTION_SCAN_ON_STARTUP=true to run once on boot.
RETENTION_SCAN_CRON=0 3 * * *
RETENTION_SCAN_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Connected mailbox sync (Phase 7d) — see docs/auth.md § Connected mailbox sync
# -----------------------------------------------------------------------------
# Prereqs: Redis (BullMQ), MinIO (.eml storage), FRONTEND_URL must match IdP redirect URIs.
# Set EMAIL_SYNC_ENABLED=true after OAuth apps are registered and redirect URIs added.
EMAIL_SYNC_ENABLED=false
EMAIL_SYNC_CRON=*/15 * * * *
# Hourly OAuth access-token refresh (keeps mailbox keys fresh even when sync is idle)
MAILBOX_TOKEN_REFRESH_ENABLED=true
MAILBOX_TOKEN_REFRESH_CRON=0 * * * *
# Auto-delete staging .eml under mailbox/ after N days (MinIO lifecycle; set 0 to disable)
MAILBOX_STAGING_RETENTION_DAYS=30
# 32+ char secret for encrypting mailbox refresh tokens at rest (required in production)
# MAILBOX_TOKEN_ENCRYPTION_KEY=
# AES-256-GCM key for SystemSecret rows (SSO / integrations). Falls back to MAILBOX_TOKEN_ENCRYPTION_KEY.
# SECRETS_ENCRYPTION_KEY=

# Dedicated mailbox OAuth apps (recommended for production).
# Falls back to MICROSOFT_* / GOOGLE_* when unset — then register BOTH SSO + mailbox redirect URIs on that client.
#
# Dev redirect URIs (FRONTEND_URL=http://localhost:5173):
#   Google:    http://localhost:5173/api/email-integration/callback/google
#   Microsoft: http://localhost:5173/api/email-integration/callback/microsoft
# Login SSO uses different paths: /api/auth/sso/{google|microsoft}/callback
MAILBOX_MICROSOFT_CLIENT_ID=
MAILBOX_MICROSOFT_CLIENT_SECRET=
MAILBOX_MICROSOFT_TENANT_ID=common
MAILBOX_GOOGLE_CLIENT_ID=
MAILBOX_GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI Assistant (Priority 4) — provider is abstracted; swap via AI_PROVIDER
# -----------------------------------------------------------------------------
# gemini | openai | anthropic
AI_PROVIDER=openai
GEMINI_API_KEY=
# Default model for GeminiProvider
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# EPO Open Patent Services (OPS) v3.2 — registry connector + watch scan
# -----------------------------------------------------------------------------
# Preferred: save Consumer Key / Secret in Settings → Integrations (encrypted in DB).
# Env values remain as fallback until DB credentials are set.
# Register an app at https://developers.epo.org/ — use Consumer Key / Secret (not the access token).
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
# Alias also accepted: EPO_CONSUMER_SECRET_KEY
EPO_API_BASE_URL=https://ops.epo.org/3.2/rest-services
# Optional override (default below):
# EPO_AUTH_URL=https://ops.epo.org/3.2/auth/accesstoken
# Nightly watch scan for active profiles with jurisdiction EP (requires Redis/BullMQ)
REGISTRY_SCAN_ENABLED=false
REGISTRY_SCAN_CRON=0 4 * * *
REGISTRY_SCAN_ON_STARTUP=false

# EPO prosecution status monitoring (legal status → correspondence + OA deadlines)
# Scans ip_rights with jurisdiction=EP, status filed|registered, application_number set
EPO_STATUS_SCAN_ENABLED=false
EPO_STATUS_SCAN_CRON=0 3 * * *
EPO_STATUS_SCAN_ON_STARTUP=false
