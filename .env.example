# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# Used by docker-compose.dev.yml (Postgres, Redis, MinIO) and the NestJS backend.
# Prisma loads DATABASE_URL from here via backend/prisma.config.ts.

# -----------------------------------------------------------------------------
# PostgreSQL (Docker)
# -----------------------------------------------------------------------------
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ip_consulting_crm
# Host port mapped to container 5432 — use 5433 if local Postgres already uses 5432
POSTGRES_PORT=5433

# Backend / Prisma connection (host dev: backend on host → Postgres in Docker)
DATABASE_URL=postgresql://crm_admin:change-me@localhost:5433/ip_consulting_crm?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ: notifications, deadline scan)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# App ports
# -----------------------------------------------------------------------------
BACKEND_PORT=3002
FRONTEND_PORT=5173
# NestJS listen port (defaults to 3002 if unset)
PORT=3002

# -----------------------------------------------------------------------------
# JWT — use long random strings in production (min 32 characters)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# App URLs (CORS, SSO redirects, password-reset links)
# -----------------------------------------------------------------------------
API_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# SSO — leave client ID/secret blank until IdP apps are registered
# Redirect URIs must use the frontend origin, e.g. http://localhost:5173/api/auth/sso/google/callback
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# MinIO (matter document storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=crm_minio
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ip-crm-documents
MINIO_ACCESS_KEY=crm_minio
MINIO_SECRET_KEY=change-me
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# Email (optional — if SMTP_HOST is unset, notification emails are logged to console)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IP Consulting CRM <noreply@example.com>

# -----------------------------------------------------------------------------
# Deadline reminder scan (BullMQ cron)
# -----------------------------------------------------------------------------
# Nightly cron (default 02:00). Set DEADLINE_SCAN_ON_STARTUP=true to run once on backend boot.
DEADLINE_SCAN_CRON=0 2 * * *
DEADLINE_SCAN_ON_STARTUP=false
